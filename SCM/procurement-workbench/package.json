{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:ssr": "npm run build && node --import ./tests/support/register-cloudflare-shim.mjs --test tests/rendered-html.test.mjs",
    "test": "vitest run && npm run test:ssr",
    "db:generate": "drizzle-kit generate",
    "db:seed-sql": "tsx scripts/generate-seed-sql.ts",
    "db:migrate:local": "tsx scripts/migrate-local-d1.ts",
    "mpp:publish": "tsx scripts/publish-mpp.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "^0.8.3",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^5.0.3",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
